<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.*?>
        <?import javafx.scene.control.*?>
        <?import javafx.scene.image.*?>
        <?import javafx.scene.layout.*?>
        <?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.FACT.controller.RegistrationController"
      alignment="CENTER"
      spacing="30"
      style="-fx-background-color: white;"
      styleClass="scene-root content card auth-card"
      stylesheets="@../css/modern.css"
      prefWidth="900"
      prefHeight="800">

   <!-- Logo -->
   <HBox alignment="CENTER">
      <ImageView fx:id="brandingImageView"
                 fitHeight="175"
                 preserveRatio="true"
                 smooth="true">
         <Image url="@../../../images/logo.png" />
      </ImageView>
   </HBox>

   <!-- Registration Form -->
   <GridPane hgap="20" vgap="25" alignment="CENTER">
      <columnConstraints>
         <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" percentWidth="30"/>
         <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" percentWidth="70"/>
      </columnConstraints>

      <!-- First Name -->
      <Label text="First Name" GridPane.rowIndex="0" GridPane.columnIndex="0">
         <font>
            <Font name="Helvetica Neue Light" size="28"/>
         </font>
      </Label>
      <TextField fx:id="firstNameTextField"
                 promptText="Jane"
                 GridPane.rowIndex="0"
                 GridPane.columnIndex="1"
                 GridPane.hgrow="ALWAYS"
                 maxWidth="Infinity">
         <font>
            <Font size="20"/>
         </font>
      </TextField>

      <!-- Last Name -->
      <Label text="Last Name" GridPane.rowIndex="1" GridPane.columnIndex="0">
         <font>
            <Font name="Helvetica Neue Light" size="28"/>
         </font>
      </Label>
      <TextField fx:id="lastNameTextField"
                 promptText="Smith"
                 GridPane.rowIndex="1"
                 GridPane.columnIndex="1"
                 GridPane.hgrow="ALWAYS"
                 maxWidth="Infinity">
         <font>
            <Font size="20"/>
         </font>
      </TextField>

      <!-- Email -->
      <Label text="Email" GridPane.rowIndex="2" GridPane.columnIndex="0">
         <font>
            <Font name="Helvetica Neue Light" size="28"/>
         </font>
      </Label>
      <TextField fx:id="emailTextField"
                 promptText="user@company.com"
                 GridPane.rowIndex="2"
                 GridPane.columnIndex="1"
                 GridPane.hgrow="ALWAYS"
                 maxWidth="Infinity">
         <font>
            <Font size="20"/>
         </font>
      </TextField>

      <!-- Password -->
      <Label text="Password" GridPane.rowIndex="3" GridPane.columnIndex="0">
         <font>
            <Font name="Helvetica Neue Light" size="28"/>
         </font>
      </Label>
      <PasswordField fx:id="setPasswordField"
                     promptText="Password"
                     GridPane.rowIndex="3"
                     GridPane.columnIndex="1"
                     GridPane.hgrow="ALWAYS"
                     maxWidth="Infinity">
         <font>
            <Font size="20"/>
         </font>
      </PasswordField>

      <!-- Confirm Password -->
      <Label text="Confirm Password" GridPane.rowIndex="4" GridPane.columnIndex="0">
         <font>
            <Font name="Helvetica Neue Light" size="28"/>
         </font>
      </Label>
      <PasswordField fx:id="confirmPasswordField"
                     promptText="Password"
                     GridPane.rowIndex="4"
                     GridPane.columnIndex="1"
                     GridPane.hgrow="ALWAYS"
                     maxWidth="Infinity">
         <font>
            <Font size="20"/>
         </font>
      </PasswordField>

      <!-- Error / Status Label -->
      <Label fx:id="registerMessageLabel"
             GridPane.rowIndex="5"
             GridPane.columnIndex="0"
             GridPane.columnSpan="2"
             alignment="CENTER"
             textFill="red"
             wrapText="true"
             style="-fx-font-size: 22;">
      </Label>

      <!-- Password Confirmation Message -->
      <Label fx:id="confirmPasswordLabel"
             GridPane.rowIndex="6"
             GridPane.columnIndex="0"
             GridPane.columnSpan="2"
             alignment="CENTER"
             textFill="RED"
             wrapText="true"
             style="-fx-font-size: 18;"/>

      <!-- Buttons -->
      <HBox spacing="20"
            alignment="CENTER"
            GridPane.rowIndex="7"
            GridPane.columnIndex="0"
            GridPane.columnSpan="2">
         <Button fx:id="signUpButton"
                 text="SIGN UP"
                 onAction="#signUpButtonOnAction"
                 prefHeight="60"
                 maxWidth="300"
                 styleClass="button-primary,button-solid,button-xl"/>
         <Button fx:id="loginButton"
                 text="LOG IN"
                 onAction="#loginButtonOnAction"
                 prefHeight="60"
                 maxWidth="300"
                 styleClass="button-primary,button-solid,button-xl"/>
      </HBox>
   </GridPane>

   <padding>
      <Insets top="40" right="60" bottom="40" left="60"/>
   </padding>
</VBox>