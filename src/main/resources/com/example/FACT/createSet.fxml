<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox minHeight="0.0" minWidth="0.0" styleClass="scene-root content" stylesheets="@../css/modern.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.FACT.controller.CreateSetController">
   <children>
      <BorderPane>
         <top>
            <AnchorPane BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="25.0" />
               </padding>
            </AnchorPane>
         </top>
         <center>
            <AnchorPane prefWidth="300" prefHeight="800" BorderPane.alignment="CENTER_LEFT">
               <children>
                  <VBox alignment="CENTER"
                        spacing="15"
                        prefWidth="300"
                        fillWidth="true"
                        AnchorPane.topAnchor="0.0"
                        AnchorPane.bottomAnchor="0.0"
                        AnchorPane.leftAnchor="0.0"
                        AnchorPane.rightAnchor="0.0">

                     <Text text="Create New Set">
                        <font>
                           <Font size="24.0" />
                        </font>
                     </Text>

                     <Label fx:id="CreateMessageLabel"
                            alignment="CENTER"
                            contentDisplay="CENTER"
                            prefWidth="1200.0">
                     </Label>

                     <ComboBox fx:id="ApplicationComboBox"
                               prefHeight="60.0"
                               promptText="Select Application"
                               style="-fx-font-size: 14px;"
                               styleClass="combo-md"
                               maxWidth="Infinity" />

                     <TextField fx:id="CategoryTextField"
                                prefHeight="60.0"
                                promptText="Set Category (eg. formulas, editing, modelling)"
                                maxWidth="Infinity">
                        <font>
                           <Font size="25.0" />
                        </font>
                     </TextField>

                     <ComboBox fx:id="DifficultyComboBox"
                               prefHeight="60.0"
                               promptText="Select difficulty"
                               style="-fx-font-size: 14px;"
                               styleClass="combo-md"
                               maxWidth="Infinity" />

                     <TextField fx:id="KeyBindTextField"
                                prefHeight="60.0"
                                promptText="KeyBind"
                                maxWidth="Infinity">
                        <font>
                           <Font size="25.0" />
                        </font>
                     </TextField>

                     <TextField fx:id="DescriptionTextField"
                                prefHeight="60.0"
                                promptText="Description"
                                maxWidth="Infinity">
                        <font>
                           <Font size="25.0" />
                        </font>
                     </TextField>
                     <padding>
                        <Insets bottom="0" left="0" right="0" top="50.0" />
                     </padding>
                     <HBox alignment="CENTER" spacing="200">
                        <Button fx:id="SaveButton"
                                mnemonicParsing="false"
                                onAction="#CreateSetAction"
                                prefHeight="60.0"
                                prefWidth="141.0"
                                text="Save"
                                textFill="WHITE"
                                styleClass="button-success,button-solid,button-xl" />
                        <Button fx:id="CancelButton"
                                mnemonicParsing="false"
                                onAction="#ClearForm"
                                prefHeight="60.0"
                                prefWidth="145.0"
                                text="Cancel"
                                styleClass="button-primary,button-solid,button-xl" />
                     </HBox>
                  </VBox>
               </children>
            </AnchorPane>
         </center>
         <padding>
            <Insets bottom="100.0" left="200.0" right="200.0" top="100.0" />
         </padding>
      </BorderPane>
   </children>
   <padding>
      <Insets left="40.0" right="40.0" />
   </padding>
</VBox>
